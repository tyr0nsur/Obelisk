{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "obelisk.chat-mode-coverage-window.v1",
  "title": "Obelisk Chat Mode Coverage Window Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "target",
    "approval",
    "notice",
    "runtime_gates",
    "evidence",
    "checks",
    "claimed_modes",
    "controlled_sends"
  ],
  "properties": {
    "schema": { "const": "obelisk.chat-mode-coverage-window.v1" },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-chat-mode-coverage$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance", "map"],
      "properties": {
        "instance": { "const": "arkserver" },
        "map": { "const": "Ragnarok" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved",
        "window_start_utc",
        "window_end_utc",
        "restart_expected",
        "rollback_defined"
      ],
      "properties": {
        "approved": { "const": true },
        "window_start_utc": { "type": "string", "format": "date-time" },
        "window_end_utc": { "type": "string", "format": "date-time" },
        "restart_expected": { "const": true },
        "rollback_defined": { "const": true }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sent", "path_label", "time_utc", "sanitized_artifact_sha256"],
      "properties": {
        "sent": { "const": true },
        "path_label": { "type": "string", "minLength": 1 },
        "time_utc": { "type": "string", "format": "date-time" },
        "sanitized_artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "runtime_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_sha256",
        "enabled_env",
        "enabled_markers",
        "disabled_marker_removed",
        "only_loadable_plugin"
      ],
      "properties": {
        "expected_sha256": {
          "const": "7e7ded49e0c658e74199801d79630bd33da407d3e468e039837bf61a9de7c520"
        },
        "enabled_env": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "enabled_markers": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "disabled_marker_removed": { "const": "disable-plugins" },
        "only_loadable_plugin": { "const": "oChatLogger" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "copied_log_path",
        "copied_log_sha256",
        "analyzer_summary_path",
        "complete_window_evidence"
      ],
      "properties": {
        "copied_log_path": { "type": "string", "minLength": 1 },
        "copied_log_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "analyzer_summary_path": { "type": "string", "minLength": 1 },
        "complete_window_evidence": { "const": true }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_check", "post_check", "rollback_completed"],
      "properties": {
        "pre_check": { "const": "passed" },
        "post_check": { "const": "passed" },
        "rollback_completed": { "const": true }
      }
    },
    "claimed_modes": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 3 },
      "minItems": 1,
      "uniqueItems": true
    },
    "controlled_sends": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mode",
          "mode_name",
          "precondition",
          "planned_send_time_utc",
          "observed_send_time_utc",
          "expected_message_size_bytes",
          "tester_result",
          "correlation"
        ],
        "properties": {
          "mode": { "type": "integer", "minimum": 0, "maximum": 3 },
          "mode_name": { "enum": ["GlobalChat", "GlobalTribeChat", "LocalChat", "AllianceChat"] },
          "precondition": { "const": "confirmed" },
          "planned_send_time_utc": { "type": "string", "format": "date-time" },
          "observed_send_time_utc": { "type": "string", "format": "date-time" },
          "expected_message_size_bytes": { "type": "integer", "minimum": 1 },
          "tester_result": { "const": "accepted_by_game" },
          "correlation": { "const": "controlled_quiet_window" }
        }
      }
    }
  }
}
