##################################
######## Instance Settings ########
##################################

# Example LinuxGSM instance config for an isolated Obelisk debug server.
# Copy to:
#   /servidor/ark/lgsm/config-lgsm/arkserver/arkserver-obelisk-debug.cfg
#
# Review variable names against the installed LinuxGSM ARK template before use.

ip="0.0.0.0"
port="7790"
queryport="27025"
rconport="27030"
maxplayers="5"
defaultmap="TheIsland"
servername="[DEBUG] Obelisk isolated - do not join"
serverpassword="change-me"
serveradminpassword="change-me"

executable="./ObeliskRunDebug.sh"

arkflag_crossplay=""
arkflag_publicipforepic=""
arkflag_NoTransferFromFiltering=""

customparms="?AltSaveDirectoryName=SavedObeliskDebug?RCONEnabled=True"

# Preferred: no live cluster flags. If a cluster is required for a specific debug test,
# use a dedicated id and directory, never MiClusterArk.
# clusterid="ObeliskDebugCluster"
# clusterdir="/servidor/ark/serverfiles/ShooterGame/SavedObeliskDebugCluster"
