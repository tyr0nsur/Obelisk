[Unit]
Description=ObeliskNative ecosystem panel (local experimental laboratory)
After=network.target

[Service]
Type=simple
User=tyronsur
Group=tyronsur
WorkingDirectory=/servidor/obelisk/Obelisk/apps/flowark/server
EnvironmentFile=/servidor/obelisk/ecosystem/panel/config/panel.env
ExecStart=/home/tyronsur/.nvm/versions/node/v24.22.1/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/servidor/obelisk/ecosystem/panel/data
ReadWritePaths=/servidor/ark/obelisk-lab/server/ShooterGame/Saved/Config/LinuxServer

[Install]
WantedBy=multi-user.target
